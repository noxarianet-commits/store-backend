# Copy this file to .env and fill in real values. Never commit .env.
SUPABASE_URL=
SUPABASE_KEY=
JWT_SECRET=
PORT=3000

SEKALIPAY_API_KEY=
SEKALIPAY_BASE_URL=
SEKALIPAY_WEBHOOK_SECRET=

FINCLOUD_API_KEY=
FINCLOUD_BASE_URL=
FINCLOUD_PPOB_WEBHOOK_SECRET=

# Legacy FinCloud webhook. Disabled by default; DYQRIS remains the active gateway.
FINCLOUD_WEBHOOK_ENABLED=false
# Comma-separated reference IDs that should always receive HTTP 200 without DB access.
FINCLOUD_IGNORED_REFF_IDS=

BACKEND_URL=
FRONTEND_URL=

RESEND_API_KEY=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=

SEKALIPAY_GATEWAY_API_KEY=
SEKALIPAY_GATEWAY_SECRET_KEY=
SEKALIPAY_GATEWAY_BASE_URL=
SEKALIPAY_MERCHANT_CODE=

DYQRIS_BASE_URL=
DYQRIS_API_KEY=
DYQRIS_WEBHOOK_SECRET=

OKECONNECT_BASE_URL=
OKECONNECT_MEMBER_ID=
OKECONNECT_PIN=
OKECONNECT_PASSWORD=
OKECONNECT_PRICE_LIST_ID=
OKECONNECT_PRICE_LIST_URL=
OKECONNECT_CALLBACK_SECRET=

MAILKETING_API_TOKEN=
MAILKETING_FROM_EMAIL=

# Optional runtime controls
LOG_LEVEL=info
LOG_STACKS=false
CRON_ENABLED=true
PAYMENT_POLL_CRON=*/2 * * * *
